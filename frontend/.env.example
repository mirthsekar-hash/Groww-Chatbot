# Server-side proxy target (recommended on Vercel — not sent to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Optional public URL (same as BACKEND_URL if you only have one Railway URL).
# See deployment.md — use your production API URL here or in BACKEND_URL.
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
